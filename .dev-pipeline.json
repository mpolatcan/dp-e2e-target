{
  "commands": {
    "lint": "node scripts/lint.mjs",
    "build": "npm run build",
    "test": "node --test test/*.test.mjs",
    "preCommit": [
      "node scripts/gen-exports.mjs"
    ]
  },
  "ci": {
    "monitorCi": true
  },
  "branch": {
    "baseBranch": "develop",
    "maxAttempts": 4
  },
  "claudeMd": {
    "revise": true
  }
}
